{
    "block": {
        "defaults": {},
        "pairs": {},
        "matches": {
            "ID": {
                "field": "properties.shortname"
            },
            "year": {
                "field": "properties.year",
                "script": "field = tostring(field)"
            },
            "title": {
                "field": "properties.title"
            },
            "type": {
                "field": "properties.bibliographic_type",
                "convert": {
                    "Article": "{\"0\": \"ARTICLE\"}",
                    "Book": "{\"1\": \"BOOK\"}",
                    "Report": "{\"12\": \"TECHREPORT\"}",
                    "THEREDA-Journal": "{\"0\": \"ARTICLE\"}",
                    "THEREDA-Report": "{\"12\": \"TECHREPORT\"}",
                    "Ph.D. thesis": "{\"10\": \"PHDTHESIS\"}",
                    "Contribution to Proceeding": "{\"6\": \"INPROCEEDINGS\"}",
                    "Personal communication": "{\"9\": \"MISC\"}"
                }
            },
            "author": {
                "field": "properties.author",
                "script": "local raw = field[1]\nlocal parts = {}\nfor tok in raw:gmatch('[^,]+') do\n    parts[#parts+1] = tok:match('^%s*(.-)%s*$')\nend\nlocal authors = {}\nlocal i = 1\nwhile i <= #parts do\n    if parts[i+1] ~= nil then\n        authors[#authors+1] = parts[i] .. ', ' .. parts[i+1]\n        i = i + 2\n    else\n        authors[#authors+1] = parts[i]\n        i = i + 1\n    end\nend\nfield = authors"
            },
            "editors": {
                "field": "properties.editor",
                "script": "local raw = field[1]\nif raw:find(';') then\n    local eds = {}\n    for tok in raw:gmatch('[^;]+') do\n        eds[#eds+1] = tok:match('^%s*(.-)%s*$')\n    end\n    field = eds\nelse\n    field = {raw}\nend"
            },
            "pubname": {
                "field": "properties.journal"
            },
            "bookname": {
                "field": "properties.booktitle"
            },
            "chapter": {
                "field": "properties.chapter"
            },
            "volume": {
                "field": "properties.volume",
                "script": "field = tostring(field)"
            },
            "reportnumber": {
                "field": "properties.number"
            },
            "page": {
                "field": "properties.pages"
            },
            "edition": {
                "field": "properties.edition"
            },
            "publisher": {
                "field": "properties.publisher"
            },
            "institution": {
                "field": "properties.institution"
            },
            "location": {
                "field": "properties.address"
            },
            "doi": {
                "field": "properties.identifiers.DOI"
            },
            "isbn_issn": {
                "field": "properties.identifiers.ISBN_ISSN",
                "script": "field = tostring(field)"
            },
            "puburl": {
                "field": "properties.links.url"
            },
            "conference": {
                "field": "properties.note"
            }
        },
        "script": "if rintable.properties.journal == 'not applicable because source is not a journal' then\n    rintable.properties.journal = nil\nend;"
    },
    "renderer": "JSON",
    "label": "VertexDataSource",
    "comment": "THEREDA bibliography import"
}
