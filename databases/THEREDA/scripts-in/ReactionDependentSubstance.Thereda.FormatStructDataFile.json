        "script":   "formula = rintable.properties.symbol;
        if (formula == 'H2O(l)') then rintable.properties.class_ = {} rintable.properties.class_['3'] = 'SC_AQSOLVENT' rintable.properties.aggregate_state = {} rintable.properties.aggregate_state['4'] =  'AS_AQUEOUS' rintable.properties.TPMethods = nil end;
        if string.match(formula, '%(g%)') then rintable.properties.class_ = {} rintable.properties.class_['1'] = 'SC_GASFLUID' rintable.properties.aggregate_state = {} rintable.properties.aggregate_state['0'] =  'AS_GAS' rintable.properties.TPMethods = { {method = {['40'] = 'mv_pvnrt'}} } end;
        if string.match(formula, '<.->') then rintable.properties.class_ = {} rintable.properties.class_['2'] = 'SC_AQSOLUTE' rintable.properties.aggregate_state = {} rintable.properties.aggregate_state['4'] =  'AS_AQUEOUS' rintable.properties.TPMethods = nil end;
formula = string.gsub(formula, '(_.*)', '');
formula = string.gsub(formula, '<(%d*)->',  '-%1' );
formula = string.gsub(formula, '<(%d*)+>',  '+%1' );
formula = string.gsub(formula, '<0>',  '@' );
formula = string.gsub(formula, '%(l%)',  '@' );
formula = string.gsub(formula, '%(g%)',  '' );
formula = string.gsub(formula, '%(cr%)',  '' );
formula = string.gsub(formula, '%(am%)',  '' );
formula = string.gsub(formula, '%(red%)',  '' );
formula = string.gsub(formula, '%(yellow%)',  '' );
formula = string.gsub(formula, '%((am,hyd%)',  '' );
formula = string.gsub(formula, '%((mcr,beta%)',  '' );
formula = string.gsub(formula, '%(s%)',  '' );
formula = string.gsub(formula, '%(mcr%)',  '' );
formula = string.gsub(formula, '%(ncr%)',  '' );
formula = string.gsub(formula, '%(lin%)',  '' );
formula = string.gsub(formula, '%(cycl%)',  '' );
formula = string.gsub(formula, '%(subst%)',  '' );
formula = string.gsub(formula, '%(dis%)',  '' );
formula = string.gsub(formula, '^O2(@?)$',  'O|0|2%1' );
formula = string.gsub(formula, '^H2(@?)$',  'H|0|2%1' );
formula = string.gsub(formula, ':([%d%.]*)([^:%s]*)',  '(%2)%1' );
formula = string.gsub(formula, 'ClO4-', 'Cl|7|O' );
rintable.properties.formula = formula;
rintable.properties.name = '_rdc_' .. rintable.properties.symbol;
        local function calcmode_status(cm)
        local code, name
        if cm == 'Entered' then code, name = '1', 'ENTERED'
        elseif cm == 'NotYetDetermined' then code, name = '0', 'EMPTY'
        elseif cm == 'CGHF' or cm == 'CF' or cm == 'CRLOGK' or cm == 'CGHR' or cm == 'CTPFUNC' or cm == 'CR' or cm == 'CXTERMEXTRAP' or cm == 'CRLOGKT' or cm == 'CV' or cm == 'CXTERMEXTRAP2' or cm == 'CRHO' then code, name = '3', 'CALCULATED'
        end;
        if code == nil then return nil end;
        return {[1] = {[code] = name}}
        end;
        for k, v in pairs(rintable.properties.temp_import) do
        if v.names ~= nil then
        local meta = 'dataclass: ' .. tostring(v.names[1]) .. '; dataquality: ' .. tostring(v.names[2]) .. '; editor: ' .. tostring(v.names[3])
        if v.comment == nil then v.comment = meta else v.comment = v.comment .. '; ' .. meta end
        v.status = calcmode_status(v.names[4])
        v.names = nil
        end;
        if v.name == 'DFG298' and v.values ~= nil then rintable.properties.sm_gibbs_energy = v end;
        if v.name == 'DFH298' and v.values ~= nil then rintable.properties.sm_enthalpy = v end;
        if v.name == 'S298' and v.values ~= nil then rintable.properties.sm_entropy_abs = v end;
        if v.name == 'CP298' and v.values ~= nil then rintable.properties.sm_heat_capacity_p = v end;
        if v.name == 'V298' and v.values ~= nil then rintable.properties.sm_volume = v end;
        end;
        if rintable.properties.sm_gibbs_energy ~= nil then rintable.properties.sm_gibbs_energy.units = {'J/mol'} end
        if rintable.properties.sm_enthalpy ~= nil then rintable.properties.sm_enthalpy.units = {'J/mol'} end 
        if rintable.properties.sm_entropy_abs ~= nil then rintable.properties.sm_entropy_abs.units = {'J/(mol*K)'} end
        if rintable.properties.sm_heat_capacity_p ~= nil then rintable.properties.sm_heat_capacity_p.units = {'J/(mol*K)'} end
        if rintable.properties.sm_volume ~= nil then rintable.properties.sm_volume.units = {'J/bar'} if rintable.properties.sm_volume.values ~= nil then rintable.properties.sm_volume.values[1] = rintable.properties.sm_volume.values[1]/10 end end;
        rintable.properties.temp_import = nil"
    },
