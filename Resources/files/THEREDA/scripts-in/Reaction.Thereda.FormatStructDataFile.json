        "script": "rintable.properties.name = rintable.properties.symbol;
        local function calcmode_status(cm)
        local code, name
        if cm == 'Entered' then code, name = '1', 'ENTERED'
        elseif cm == 'NotYetDetermined' then code, name = '0', 'EMPTY'
        elseif cm == 'CGHF' or cm == 'CF' or cm == 'CRLOGK' or cm == 'CGHR' or cm == 'CTPFUNC' or cm == 'CR' or cm == 'CXTERMEXTRAP' or cm == 'CRLOGKT' or cm == 'CV' or cm == 'CXTERMEXTRAP2' or cm == 'CRHO' then code, name = '3', 'CALCULATED'
        end;
        if code == nil then return nil end;
        return {[1] = {[code] = name}}
        end;
        for k, v in pairs(rintable.properties.temp_import) do
        if v.name == 'DRG298' and v.values[1] ~= '---' then rintable.properties.drsm_gibbs_energy = v rintable.properties.drsm_gibbs_energy.values = {v.values[1]} end;
        if v.name == 'DRH298' and v.values[1] ~= '---' then rintable.properties.drsm_enthalpy = v rintable.properties.drsm_enthalpy.values = {v.values[1]} end;
        if v.name == 'LOGK298' and v.values[1] ~= '---' then rintable.properties.logKr = v rintable.properties.logKr.values = {v.values[1]} end;
        if v.name == 'DRCP298' and v.values[1] ~= '---' then rintable.properties.drsm_heat_capacity_p = v rintable.properties.drsm_heat_capacity_p.values = {v.values[1]} end;
        if v.name == 'DRS298' and v.values[1] ~= '---' then rintable.properties.drsm_entropy = v rintable.properties.drsm_entropy.values = {v.values[1]} end;
        if v.name == 'DRV298' and v.values[1] ~= '---' then rintable.properties.drsm_volume = v rintable.properties.drsm_volume.values = {v.values[1]} end;
        if v.name == 'LOGKT' and v.values[1] ~= '---' then rintable.properties.TPMethods[1].limitsTP.lowerT = v.values[10] v.values[10] = nil
        rintable.properties.TPMethods[1].limitsTP.upperT = v.values[8] v.values[8] = nil 
        rintable.properties.TPMethods[1].limitsTP.lowerP = v.values[9] v.values[9] = nil rintable.properties.TPMethods[1].limitsTP.upperP = v.values[7] v.values[7] = nil
        rintable.properties.TPMethods[1].logk_ft_coeffs.values = v.values 
	if v.comment ~= 'NEA-transformed' and rintable.properties.TPMethods ~= nil then rintable.properties.TPMethods = nil end;
	--[[ if v.name == 'LOGKT' and v.names[4] ~= 'CXTERMEXTRAP2' then print(rintable.properties.symbol .. ' does not have 3-term extrpolation and will not be correctly represented in GEMS') end;--]]
        end;
        if v.names ~= nil then
        local meta = 'dataclass: ' .. tostring(v.names[1]) .. '; dataquality: ' .. tostring(v.names[2]) .. '; editor: ' .. tostring(v.names[3])
        if v.comment == nil then v.comment = meta else v.comment = v.comment .. '; ' .. meta end
        v.status = calcmode_status(v.names[4])
        v.names = nil
        end;
  end;
        if rintable.properties.logKr ~= nil and rintable.properties.drsm_gibbs_energy == nil and rintable.properties.drsm_enthalpy == nil and rintable.properties.drsm_entropy == nil and rintable.properties.drsm_heat_capacity_p == nil and rintable.properties.drsm_volume == nil then
        local logk_val = rintable.properties.logKr.values[1]
        if rintable.properties.TPMethods ~= nil then rintable.properties.TPMethods[1].logk_ft_coeffs.values[1] = logk_val end;
        rintable.properties.drsm_gibbs_energy = { values = { -8.31451 * 298.15 * math.log(10) * logk_val }, status = {[1] = {['3'] = 'CALCULATED'}}, comment = 'calculated from logKr (R=8.31451 J/(mol*K), T=298.15 K)' }
        end;
	if rintable.properties.TPMethods ~= nil then x = rintable.properties.TPMethods[1].logk_ft_coeffs.values
	if x[1] == 0 and x[2] == 0 and x[3] == 0 and x[4] == 0 and x[5] == 0 and x[6] == 0 then   rintable.properties.TPMethods = nil end; end;
        if rintable.properties.drsm_gibbs_energy ~= nil then rintable.properties.drsm_gibbs_energy.units = {'J/mol'} end
        if rintable.properties.drsm_enthalpy ~= nil then rintable.properties.drsm_enthalpy.units = {'J/mol'} end 
        if rintable.properties.drsm_entropy ~= nil then rintable.properties.drsm_entropy.units = {'J/(mol*K)'} end
        if rintable.properties.drsm_heat_capacity_p ~= nil then rintable.properties.drsm_heat_capacity_p.units = {'J/(mol*K)'} end
        if rintable.properties.drsm_volume ~= nil then rintable.properties.drsm_volume.units = {'J/bar'} if rintable.properties.drsm_volume.values ~= nil then rintable.properties.drsm_volume.values[1] = rintable.properties.drsm_volume.values[1]/10 end end;
        rintable.properties.temp_import = nil
